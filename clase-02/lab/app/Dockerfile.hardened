# syntax=docker/dockerfile:1

# Imagen endurecida de tienda-api. Misma aplicación que la clase 2.
# Cambios frente a la clase 2: usuario sin shell ni home, etiquetas OCI,
# arranque compatible con sistema de archivos de solo lectura y sin pip en runtime.

FROM python:3.12-slim AS builder

WORKDIR /build
COPY requirements.txt .
RUN python -m venv /venv \
    && /venv/bin/pip install --no-cache-dir --upgrade pip \
    && /venv/bin/pip install --no-cache-dir -r requirements.txt \
    && /venv/bin/pip uninstall -y pip setuptools wheel

FROM python:3.12-slim AS runtime

LABEL org.opencontainers.image.title="tienda-api" \
      org.opencontainers.image.description="API del curso de Docker Avanzado" \
      org.opencontainers.image.version="4.0" \
      org.opencontainers.image.base.name="docker.io/library/python:3.12-slim"

ENV PATH="/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1

# Usuario sin home y sin shell. UID y GID fijos para que el pod pueda
# declarar runAsUser sin depender de la imagen.
RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin app

# El runtime no necesita pip: el venv ya tiene las dependencias instaladas.
RUN rm -rf /usr/local/lib/python3.12/site-packages/pip \
           /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
           /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12

WORKDIR /app
COPY --from=builder /venv /venv
COPY --chown=10001:10001 app.py .

USER 10001:10001
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')"

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "--access-logfile", "-", "app:app"]
