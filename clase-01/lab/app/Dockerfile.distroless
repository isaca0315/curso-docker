# Variante distroless: sin shell, sin gestor de paquetes y usuario 65532.
# El builder usa la misma versión de Python que la imagen final (3.11).
FROM python:3.11-slim AS builder

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir --no-compile --target /deps -r requirements.txt \
    && rm -rf /deps/bin

FROM gcr.io/distroless/python3-debian12:nonroot

ENV PYTHONPATH=/deps \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY --from=builder /deps /deps
COPY app.py .

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD ["/usr/bin/python3.11", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')"]

ENTRYPOINT ["/usr/bin/python3.11", "-m", "gunicorn"]
CMD ["--bind", "0.0.0.0:8000", "app:app"]
